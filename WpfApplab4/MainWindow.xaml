<Window x:Class="WpfApplab4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApplab4"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>

        <!-- Fila 1: Búsqueda por proveedor -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0">
            <TextBox Name="txtBuscar" Width="250" Height="30" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
            <Button Content="Buscar" Width="75" Height="30" Click="Button_Buscar_proveedor"/>
        </StackPanel>

        <!-- Fila 2: Botones de listado -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,50,0,0">
            <Button Content="Listar Productos" Width="150" Height="30" Margin="0,0,10,0" Click="Button_Productos"/>
            <Button Content="Listar Categorias" Width="150" Height="30" Margin="0,0,10,0" Click="Button_Pedidos"/>
            <Button Content="Listar proveedor" Width="150" Height="30" Click="Button_Proveedor"/>
        </StackPanel>

        <!-- Fila 3: Filtro por fechas de pedidos -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,100,0,0">
            <Label Content="Desde:" VerticalAlignment="Center"/>
            <DatePicker Name="dpInicio" Width="120" Margin="5,0"/>
            <Label Content="Hasta:" VerticalAlignment="Center"/>
            <DatePicker Name="dpFin" Width="120" Margin="5,0"/>
            <Button Content="Buscar Pedidos por Fecha" Width="180" Click="Button_BuscarPedidosPorFecha"/>
        </StackPanel>

        <!-- Fila 4: Resultados en DataGrid -->
        <DataGrid Name="dgall" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="10,150,10,10"/>

    </Grid>
</Window>
