<Window x:Class="WpfApplab4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApplab4"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- Aquí estarán Fax y Botones -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <!-- Filas 0 a 4 = campos -->
        <Label Grid.Row="0" Grid.Column="0" Content="ID Cliente:" Margin="5"/>
        <TextBox x:Name="txtIdCliente" Grid.Row="0" Grid.Column="1" Margin="5"/>
        <Label Grid.Row="0" Grid.Column="2" Content="Nombre Compañía:" Margin="5"/>
        <TextBox x:Name="txtNombreCompañia" Grid.Row="0" Grid.Column="3" Margin="5"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Nombre Contacto:" Margin="5"/>
        <TextBox x:Name="txtNombreContacto" Grid.Row="1" Grid.Column="1" Margin="5"/>
        <Label Grid.Row="1" Grid.Column="2" Content="Cargo Contacto:" Margin="5"/>
        <TextBox x:Name="txtCargoContacto" Grid.Row="1" Grid.Column="3" Margin="5"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Dirección:" Margin="5"/>
        <TextBox x:Name="txtDireccion" Grid.Row="2" Grid.Column="1" Margin="5"/>
        <Label Grid.Row="2" Grid.Column="2" Content="Ciudad:" Margin="5"/>
        <TextBox x:Name="txtCiudad" Grid.Row="2" Grid.Column="3" Margin="5"/>

        <Label Grid.Row="3" Grid.Column="0" Content="Región:" Margin="5"/>
        <TextBox x:Name="txtRegion" Grid.Row="3" Grid.Column="1" Margin="5"/>
        <Label Grid.Row="3" Grid.Column="2" Content="Código Postal:" Margin="5"/>
        <TextBox x:Name="txtCodPostal" Grid.Row="3" Grid.Column="3" Margin="5"/>

        <Label Grid.Row="4" Grid.Column="0" Content="País:" Margin="5"/>
        <TextBox x:Name="txtPais" Grid.Row="4" Grid.Column="1" Margin="5"/>
        <Label Grid.Row="4" Grid.Column="2" Content="Teléfono:" Margin="5"/>
        <TextBox x:Name="txtTelefono" Grid.Row="4" Grid.Column="3" Margin="5"/>

        <!-- Fila 5 = Fax + Botones -->
        <Label Grid.Row="5" Grid.Column="0" Content="Fax:" Margin="5"/>
        <TextBox x:Name="txtFax" Grid.Row="5" Grid.Column="1" Margin="5"/>

        <StackPanel Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="5">
            <Button Content="Registrar Cliente" Width="150" Margin="5" Click="Button_RegistrarCliente"/>
            <Button Content="Listar Clientes" Width="150" Margin="5" Click="Button_ListarClientes"/>
        </StackPanel>

        <!-- Fila 6 = DataGrid -->
        <DataGrid x:Name="dgall" Grid.Row="6" Grid.ColumnSpan="4" Margin="5" AutoGenerateColumns="True" Height="300"/>
    </Grid>

</Window>
